---
import Page from '../layouts/Page.astro';
import Avatars from '../components/Avatars.astro';
import StatusSticker from '../components/StatusSticker.astro';
import { docTypes, site } from '../lib/config';
import { getPeople, getProjectStyles, getReviews, projectStyle, statusInfo, type Decision } from '../lib/decisions';
import { pad4 } from '../lib/card';
import { daysUntil, urgency } from '../lib/dates';
import { t } from '../lib/i18n';

const monthName = (m: number) => new Date(Date.UTC(2000, m - 1, 1)).toLocaleDateString('en', { month: 'short', timeZone: 'UTC' });

const rows = await getReviews();
const styles = await getProjectStyles();
const people = await getPeople();
const soon = site.reviews.soon ?? 30;
const today = new Date();

const label = (d: Decision) => `${styles.get(d.project)?.name ?? d.project} ${(d.type ? docTypes[d.type].label : '').toUpperCase()} ${pad4(d.number)}`;
const dateBlock = (iso: string) => {
  const [y, m, day] = iso.split('-');
  return { day: Number(day), month: `${monthName(Number(m))} ${y}` };
};
const groups = (['overdue', 'soon', 'later'] as const).map((key) => ({
  key,
  heading: t(`reviews.${key}`),
  rows: rows.filter((d) => urgency(daysUntil(d.review.due, today), soon) === key),
}));
---

<Page title={t('reviews.title')} accent={t('reviews.titleAccent')} eyebrow={t('nav.reviews')}>
  <Fragment slot="lede" set:html={rows.length ? `${t('reviews.lede', { count: rows.length })} <span data-overdue></span>` : t('reviews.ledeEmpty')} />
  {
    rows.length === 0 ? (
      <p set:html={t('reviews.empty')} />
    ) : (
      <div data-reviews data-soon={soon}>
        {groups.map(({ key, heading, rows }) => (
          <section data-group={key} hidden={rows.length === 0}>
            <h2 class="bl__group">{heading} <span data-count>{rows.length}</span></h2>
            <ol class="bl">
              {rows.map((d) => {
                const project = styles.get(d.project) ?? projectStyle(d.project);
                const date = dateBlock(d.review.due);
                return (
                  <li class={`bl__row ink-${project.ink}`} data-review-by={d.review.due}>
                    <div class="bl__date"><b>{date.day}</b><span>{date.month}</span></div>
                    <a class="bl__main" href={d.href}>
                      {d.status && <StatusSticker status={d.status} />}
                      <span>
                        <em>{label(d)} · {statusInfo(d.status)?.label ?? d.status}</em>
                        <b>{d.title}</b>
                        <small>
                          {[d.review.reviewed ? t('reviews.lastReviewed', { date: d.review.reviewed }) : t('reviews.notReviewed'), d.review.every && t('reviews.every', { every: d.review.every })].filter(Boolean).join(' · ')}
                        </small>
                      </span>
                    </a>
                    <div class="bl__d">
                      <b aria-hidden="true">{d.review.due}</b>
                      <span data-due></span>
                    </div>
                    <Avatars handles={d.authors} people={people} />
                  </li>
                );
              })}
            </ol>
          </section>
        ))}
      </div>
    )
  }
</Page>

<script>
  import { t } from '../lib/i18n';
  import { formatLongDate, stampDueRows } from '../lib/dates';

  const today = new Date();
  const root = document.querySelector<HTMLElement>('[data-reviews]');
  if (root) {
    const soon = Number(root.dataset.soon);
    const sections = new Map([...root.querySelectorAll<HTMLElement>('[data-group]')].map((s) => [s.dataset.group!, s]));
    const rows = [...root.querySelectorAll<HTMLElement>('.bl__row')].sort((a, b) => a.dataset.reviewBy!.localeCompare(b.dataset.reviewBy!));
    const counts = new Map<string, number>();
    for (const { row, level } of stampDueRows(rows, soon, today)) {
      counts.set(level, (counts.get(level) ?? 0) + 1);
      sections.get(level)!.querySelector('.bl')!.append(row);
    }
    for (const [key, section] of sections) {
      section.hidden = !counts.get(key);
      section.querySelector('[data-count]')!.textContent = String(counts.get(key) ?? 0);
    }
    const overdue = counts.get('overdue') ?? 0;
    const lede = document.querySelector<HTMLElement>('[data-overdue]');
    if (lede) lede.innerHTML = overdue ? `<b>${t('reviews.overdueCount', { count: overdue })}</b>` : t('backlog.noneOverdue');
  }
  const eyebrow = document.querySelector('.page-head .eyebrow');
  if (eyebrow) eyebrow.append(t('backlog.today', { date: formatLongDate(today) }));
</script>
