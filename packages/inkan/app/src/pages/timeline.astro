---
import Page from '../layouts/Page.astro';
import RecordCard from 'virtual:inkan/components/RecordCard';
import StatusSticker from '../components/StatusSticker.astro';
import { pad4 } from '../lib/card';
import { t } from '../lib/i18n';
import { getDecisions, getPeople, getProjectStyles, projectStyle, type Decision } from '../lib/decisions';

const dated = (await getDecisions()).filter((d): d is Decision & { date: Date } => Boolean(d.date));
const styles = await getProjectStyles();
const people = await getPeople();

const months = new Map<string, Decision[]>();
for (const d of dated) {
  const key = d.date.toISOString().slice(0, 7);
  months.set(key, [...(months.get(key) ?? []), d]);
}
/** Past this many records, years older than the latest two collapse to compact rows to keep the page light. */
const COMPACT_ABOVE = 150;
const latestYear = dated.length ? dated[0].date.getUTCFullYear() : 0;
const monthName = (key: string, month: 'short' | 'long') => new Date(`${key}-01T00:00:00Z`).toLocaleDateString('en', { month, timeZone: 'UTC' });
---

<Page
  title={t('timeline.title')}
  accent={t('timeline.titleAccent')}
  eyebrow={t('nav.timeline')}
  lede={t('timeline.lede', { count: dated.length })}
>
  <div class="tl">
    {
      (() => {
        let year = '';
        return [...months].map(([key, items]) => {
          const newYear = key.slice(0, 4) !== year;
          year = key.slice(0, 4);
          return (
            <>
              {newYear && <h2 class="yr"><span>{year}</span><i aria-hidden="true"></i></h2>}
              <section class="month">
                <div class="month__l">
                  <h3>
                    <time datetime={key}>
                      <b aria-hidden="true">{monthName(key, 'short')}</b>
                      <b class="sr-only">{monthName(key, 'long')} {year}</b>
                    </time>
                  </h3>
                  <span>{t('timeline.records', { count: items.length })}</span>
                </div>
                {dated.length > COMPACT_ABOVE && Number(year) < latestYear - 1 ? (
                  <ul class="month__list">
                    {items.map((d) => (
                      <li>
                        <a href={d.href}>
                          {d.status && <StatusSticker status={d.status} size="22px" />}
                          <b>{(styles.get(d.project) ?? projectStyle(d.project)).name} {pad4(d.number)}</b>
                          <span>{d.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <ul class="month__cards" role="list">
                    {items.map((d) => (
                      <li>
                        <RecordCard decision={d} project={styles.get(d.project) ?? projectStyle(d.project)} people={people} width={150} />
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            </>
          );
        });
      })()
    }
  </div>
</Page>

<style is:global>
  .tl .month__l h3, .tl .month__l span { text-transform: uppercase; }
  .tl .month__l h3 b { font-weight: inherit; }
  .tl ul.month__cards { margin: 0; padding: 0; list-style: none; }
</style>
