---
import Page from '../layouts/Page.astro';
import { countBy, filterHref, getDecisions } from '../lib/decisions';
import { t } from '../lib/i18n';

const tags = countBy((await getDecisions()).flatMap((d) => d.tags));
---

<Page title={t('page.tagsTitle', { count: tags.length })} accent={t('page.tagsAccent', { count: tags.length })} eyebrow={t('page.tagsEyebrow')} lede={t('page.tagsLede')}>
  <div class="tagcloud">
    {
      tags.map(([tag, n]) => (
        <a class="tag" href={filterHref('tag', tag)}>
          #{tag}
          <b>{n}</b>
        </a>
      ))
    }
  </div>
</Page>
