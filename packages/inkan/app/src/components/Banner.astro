---
/** Strip above the header from `banner` in the config. Dismissal is remembered per message. */
import Icon from './Icon.astro';
import { site } from '../lib/config';
import { t } from '../lib/i18n';

const banner = site.banner;
---

{
  banner && (
    <aside class="banner" aria-label={t('shell.announcement')} data-banner={banner.dismissible ? banner.message : undefined}>
      <span set:html={banner.message} />
      {banner.dismissible && (
        <button class="banner__x" type="button" aria-label={t('shell.dismissAnnouncement')} data-banner-close>
          <Icon name="x" />
        </button>
      )}
    </aside>
  )
}
{
  banner?.dismissible && (
    <script is:inline>
      (() => {
        const el = document.querySelector('[data-banner]');
        try {
          if (localStorage.getItem('inkan-banner') === el.dataset.banner) el.hidden = true;
        } catch {}
        el.querySelector('[data-banner-close]').addEventListener('click', () => {
          el.hidden = true;
          try { localStorage.setItem('inkan-banner', el.dataset.banner); } catch {}
        });
      })();
    </script>
  )
}
