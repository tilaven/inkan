---
import pkg from '../../../package.json';
import { site } from '../lib/config';
import { url } from '../lib/decisions';
import { resolveHref } from '../lib/links';
import { t } from '../lib/i18n';

const { copyright, links } = site.footer;
const repoUrl = pkg.repository.url.replace(/^git\+/, '').replace(/\.git$/, '');
---

<footer class="foot">
  {copyright && <span set:html={copyright} />}
  {links.map((l) => <a href={resolveHref(l.href)}>{l.label}</a>)}
  <a href={url('export/')}>{t('shell.printExport')}</a>
  <span class="foot__built" set:html={t('shell.builtWith', { link: `<a href="${repoUrl}">Inkan</a>` })} />
</footer>
