# Copy to .env and fill in. Never commit .env.

# Public URL users open, plus /oauth2/callback. Register this exact URL with the identity provider.
OAUTH2_PROXY_REDIRECT_URL=http://localhost:8080/oauth2/callback

# Keep true behind HTTPS (the normal case). Set to false only while trying it on http://localhost.
COOKIE_SECURE=true

# 32 random bytes, base64 URL-safe (oauth2-proxy decodes it to 16, 24 or 32 bytes): openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=

OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=

# Who may sign in: comma-separated email domains, or * for any verified email (then restrict at the provider).
OAUTH2_PROXY_EMAIL_DOMAINS=example.com

# --- GitHub ---
OAUTH2_PROXY_PROVIDER=github
# Only members of this organisation (and, optionally, these team slugs) get in.
# Once GITHUB_ORG is set, EMAIL_DOMAINS=* is safe; with an empty org and *, any GitHub account gets in.
OAUTH2_PROXY_GITHUB_ORG=
OAUTH2_PROXY_GITHUB_TEAM=
# OAuth app callback URL = OAUTH2_PROXY_REDIRECT_URL

# --- Google ---
# OAUTH2_PROXY_PROVIDER=google
# OAUTH2_PROXY_EMAIL_DOMAINS=your-company.com

# --- Generic OIDC (Keycloak, Entra ID, Okta, Auth0, ...) ---
# OAUTH2_PROXY_PROVIDER=oidc
# Keycloak: https://keycloak.example.com/realms/<realm>
# Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
# OAUTH2_PROXY_OIDC_ISSUER_URL=https://idp.example.com
# OAUTH2_PROXY_SCOPE=openid email profile
# Restrict by group claim instead of email domain:
# OAUTH2_PROXY_ALLOWED_GROUPS=engineering
